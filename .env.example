DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-me-generate-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
# Опционально: если сервер стоит в стране, которую Gemini API блокирует по IP —
# один или несколько (через запятую) http(s)://user:pass@host:port прокси с выходом в США/ЕС.
# При сетевой ошибке на одном прокси код автоматически пробует следующий из списка.
# Не нужно, если сервер не блокируют.
GEMINI_PROXY_URLS=
MAX_REVIEWS_PER_USER=3
UPLOAD_MAX_MB=10
MAX_QUIZ_ATTEMPTS=3
OPEN_QUESTIONS_COUNT_IN_RATING=true
W_QUIZ=0.4
W_CARD=0.5
W_REVIEW_BONUS=0.1
